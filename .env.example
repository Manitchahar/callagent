# Gemini API key from https://aistudio.google.com/apikey (free tier works)
GOOGLE_API_KEY=your-key-here
# Use the Gemini Developer API (AI Studio), not Vertex AI
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# Optional
# GEMINI_MODEL=gemini-3.8-live
# GEMINI_VOICE=Kore
# Set to 1 to put project facts in the system prompt instead of using the get_project_info tool
# INLINE_PROJECT_INFO=0
# Public hostname for Twilio's <Stream> URL (auto-detected from the request if unset)
# PUBLIC_HOST=abcd-1234.ngrok-free.app
